{
  "name": "bta-rank-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype rank and trip tracker for the Benoni Taxi Association (Etwatwa, Daveyton, Benoni).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server server/server.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "roads": "node --disable-warning=ExperimentalWarning server/fetch-roads.js"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
